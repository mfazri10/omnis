CONTROL_PLANE_DB_URL=postgresql://postgres:postgres@localhost:5432/platform
POSTGRES_BASE_URL=postgresql://postgres:postgres@localhost:5432
REDIS_URL=redis://localhost:6379
API_PORT=3000
CORS_ORIGIN=http://localhost:3001
NODE_ENV=development

# --- Auth (better-auth) ---
BETTER_AUTH_SECRET=ganti-dengan-string-acak-min-32-karakter
BETTER_AUTH_URL=http://localhost:3000
CMS_ORIGIN=http://localhost:3001

# CATATAN: user Postgres di atas wajib punya hak CREATEDB (provisioning F03
# membuat/menghapus database aplikasi). Default docker-compose (postgres) memenuhi.
# --- FCM (opsional; tanpa kunci, penyimpanan kredensial FCM ditolak jelas) ---
# Buat kunci: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# FCM_CREDENTIAL_KEY=
# PROVISION_TIMEOUT_MS=30000
# --- Email (wajib di production; development tanpa host hanya mencatat stub) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@localhost
# --- Media / upload (F09) ---
# STORAGE_DRIVER=local untuk development; wajib s3 di production.
# STORAGE_DRIVER=local
# Root penyimpanan driver lokal Fase 1 (relatif terhadap CWD proses API).
# STORAGE_LOCAL_ROOT=./storage/media
# Basis URL publik berkas lokal; dilayani GET /media/:slug/:file.
# STORAGE_PUBLIC_BASE_URL=http://localhost:3000/media
# Object storage S3-compatible (wajib saat STORAGE_DRIVER=s3).
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=platform-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://cdn.example.com/media
# Batas ukuran unggahan dalam byte (5242880 = 5 MB). Jangan melebihi
# 6 MB (6291456) karena interceptor multipart menolak file di atas
# batas memorinya sebelum validasi service berjalan.
# UPLOAD_MAX_BYTES=5242880
# Daftar MIME yang diizinkan, dipisah koma.
# UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,application/pdf
# --- Notifikasi push (F10) ---
# Development memakai noop dan menandai kampanye sebagai simulasi.
# Production mewajibkan FCM; isi service account per aplikasi di CMS.
# PUSH_DRIVER=noop
# Worker BullMQ dijalankan terpisah dengan `bun run --filter api worker:dev`
# (development) atau `bun run --filter api worker` (production).
# Runner in-process hanya berjalan pada NODE_ENV=development.
# CAMPAIGN_RUNNER=on
# Interval sapuan kampanye jatuh tempo dalam milidetik (30000 = 30 detik,
# memenuhi toleransi eksekusi ≤1 menit).
# CAMPAIGN_RUNNER_INTERVAL_MS=30000
# EXPORT_RUNNER=on
# EXPORT_RUNNER_INTERVAL_MS=5000
# EXPORT_MAX_ROWS=50000
# EXPORT_TTL_HOURS=24
# EXPORT_STORAGE_ROOT=./storage/exports
